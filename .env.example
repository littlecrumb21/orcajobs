# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# For local dev: postgresql://user:password@localhost:5432/orca_jobs
# For Neon (serverless Postgres): https://neon.tech — free tier available
# For AWS RDS: postgresql://user:password@your-rds-endpoint:5432/orca_jobs
DATABASE_URL="postgresql://user:password@localhost:5432/orca_jobs"

# ── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe ──────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook secret — from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs — create these in your Stripe Dashboard under Products
# Basic: £29 — Standard listing, 30 days
STRIPE_PRICE_BASIC="price_..."
# Featured: £59 — Highlighted + top of category, 60 days
STRIPE_PRICE_FEATURED="price_..."
# Premium: £99 — Featured + logo + social push, 90 days
STRIPE_PRICE_PREMIUM="price_..."

# ── AWS S3 (file uploads: CVs, logos) ───────────────────────────────────────
# IAM user needs: s3:PutObject, s3:GetObject, s3:DeleteObject on your bucket
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="eu-west-2"
AWS_S3_BUCKET="orca-jobs-uploads"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key from https://resend.com
# Free tier: 3,000 emails/month
RESEND_API_KEY="re_..."
EMAIL_FROM="Orca Jobs <hello@orca.jobs>"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
